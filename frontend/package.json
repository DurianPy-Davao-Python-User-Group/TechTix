{
  "name": "techtix",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dummy": "tsc && vite build --mode dummy",
    "lint": "eslint .",
    "start": "vite preview",
    "pretty": "prettier --write \"./**/*.{js,jsx,ts,tsx,json,scss,sass,css}\"",
    "format:check": "prettier --check .",
    "format:check:ci": "./node_modules/.bin/prettier --check .",
    "generate:outputs": "node scripts/generate-amplify-outputs.mjs",
    "generate:env": "node scripts/generate-env.mjs",
    "generate": "node scripts/generate-all.mjs",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.2.1",
    "@module-federation/runtime": "^2.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-link": "^3.2.0",
    "@tiptap/extension-placeholder": "^3.2.0",
    "@tiptap/extension-text-align": "^3.2.0",
    "@tiptap/extension-underline": "^3.2.0",
    "@tiptap/pm": "^3.2.0",
    "@tiptap/react": "^3.2.0",
    "@tiptap/starter-kit": "^3.2.0",
    "@types/dompurify": "^3.0.5",
    "aws-amplify": "^6.15.5",
    "aws-rum-web": "^3.2.1",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "lucide-react": "^1.37.0",
    "moment": "^2.30.1",
    "react": "19.2.8",
    "react-day-picker": "^9.9.0",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-router": "^8.3.1",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "ulid": "^3.0.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@aws-sdk/client-ssm": "^3.873.0",
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@module-federation/vite": "^1.22.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.83.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "svgo": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.1.3",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@typescript-eslint/parser": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/eslint-plugin": {
      "typescript": "$typescript"
    }
  }
}
